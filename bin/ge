#!/bin/sh
# SH FILE: ge
#
# Purpose   : Launch an independent GUI Emacs process.  Supports macOS and Linux.
# Created   : Tuesday, August  3 2021.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-10-08 17:03:31 EDT, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Description
# -----------
#
# Launch an independent GUI Emacs in the background of the launching terminal
# shell executing the command.  The current directory of the GUI Emacs process
# is set to the current directory of the terminal shell from which the 'ge'
# command was issued.

#
# ----------------------------------------------------------------------------
# Code
# ----
#

pgm_name="${0##*/}"

print_usage()
{
    printf -- "\
%s : Launch an independent graphical-mode instance of Emacs.
     Direct launches run in the background with stdout and stderr discarded.
     macOS application launches use open and preserve open's diagnostics.
     Give focus to the graphical Emacs OS window.

 Usage: %s -h | --help

  • Print this help information.

 Usage: %s [OPTION-or-FILENAME]...

  • Launch the graphical Emacs process with the specified OPTION-or-FILENAME.
    The process is launched from within the current directory and inherits the
    current environment variables.
    This does not auto-load any session.

 Usage: %s -s [SESSION-NAME] [--] [OPTION-or-FILENAME]...
        %s --session=SESSION_NAME [OPTION-or-FILENAME]...
        PEL_SESSION=SESSION-NAME %s -s -- [OPTION-or-FILENAME]...

  • Execute a graphical Emacs process, passing the OPTION-or-FILENAME options
    to Emacs but also forcing the automatic loading of an easysession.  The
    name of the session is either specified on the command line as
    SESSION-NAME or taken from the PEL_SESSION environment variable according
    to the following rules:
     • An explicit session name supplied through -s NAME or --session=NAME
       overrides PEL_SESSION.
     • With bare -s, a nonempty PEL_SESSION supplies the session name.
     • With bare -s and an unset or empty PEL_SESSION, the session name
       is set to \".\"; this requires a directory-specific session whose
       name is extracted by Emacs pel-session logic from the PEL easysession
       catalog file.
     • PEL_SESSION alone does not activate session loading.
       Use -s or --session=NAME to activate session loading.
     • -s does not consume a following argument that starts with a dash.
       Use --session=NAME for such a name.
     • Use -s -- before forwarded arguments when omitting the session name.

  The -s and --session options force the automatic loading of a session
  using the Emacs easysession logic and are active when the following
  conditions are met:
    • The PEL pel-use-easysession      user-option is turned on.
    • The PEL pel-easysession-autoload user-option is turned on.
    • The easysession.el package is installed (PEL installs it when
      Emacs starts and pel-use-easysession is on)
    • The session directory exists (see FILES).
  For unnamed, directory-specific session invoked with -s without a name,
  the following extra condition must be met for the loading of the
  session.  %s checks the first, Emacs pel-session code checks the other two:
    • The PEL easysession catalog file exists (see FILES).
    • It has a line that identifies a session for the current directory.
    • That file is present in the session directory.

 FILES
   • Emacs user directory: most often: '~/.emacs.d' but also '~/.config/emacs/'
                           on some XDG compliant systems.
   • session directory: the 'easysession' sub-directory of the Emacs user
                        directory.
   • PEL easysession catalog file:  'pel-easysession-catalog.txt' inside the
                                     Emacs user directory.

 ENVIRONMENT
    • PEL_SESSION_CATALOG :
         The file name of the PEL easysession catalog file.  No path; the file
         is located inside the user's Emacs directory. Overrides the default
         shown above.  Required when the user changed the default value of PEL
         pel-easysession-catalog-filename user-option in Emacs.
    • PEL_GE_DIR:
         On macOS only.  Identifies the directory where the emacs graphics-capable
         executable may be stored.  Used if non empty and if executable emacs
         file exists.

 NOTES
    • With the -s option with no named session, place a -- before a following
      file name otherwise it is interpreted as a session name.
    • %s launches Emacs inside an independent OS window, but that process
      inherits the current directory and the complete environment of the
      current shell.  This includes the PATH, LIBPATH, MANPATH, and several
      other useful environment variables.  This can be useful in many
      situations.  You can even launch different Emacs processes from
      different shells, each one having different specialized environments,
      and potentially an associated session.
    • Control is returned right away to the terminal shell.
    • If PEL dual-customization mode is enabled, enable pel-use-easysession
      and pel-easysession-autoload in the graphical-mode customization.
    • For direct graphical Emacs launches, stdout and stderr are discarded.
      Startup errors and external-debugging-output are therefore not visible.
      A successful ge exit status does not confirm successful Emacs startup.

 LIMITATIONS
    • The -s option does not check if a session for the current working
      directory exists in the PEL easysession catalog file.  That is done
      by Emacs pel-session.el logic.  No harm is done: Emacs won't auto-load
      a session.  Use it as a reminder to save the session with a name
      associated with the current working directory.
    • The -s option looks for the default PEL easysession catalog file name:
      the default value of the pel-easysession-catalog-filename user-option.
      If pel-easysession-catalog-filename is modified you must store its
      name in the PEL_SESSION_CATALOG environment variable.
    • When auto-loading a session with easysession via the -s or --session
      option, %s assumes that the Emacs user directory currently used is the
      same that was used when session information was saved.  The Emacs user
      directory stores Emacs customization files, package files, easysession
      files, PEL easysession catalog file.  If you invoked Emacs with its
      --init-directory in the past please ensure that you do not need session
      information from that other Emacs user directory as %s session
      pre-condition check and execution and Emacs pel-session code both use
      this information to validate and successfully restore an easysession
      session.

 DIAGNOSTICS
  %s prints error information on failures. It prints extra details when the
  PEL_DIAG environment variable is set to 1.  Specifically it displays more
  information when conditions are not met for the loading of a session.
  Use that to troubleshoot environment problems.
  • With USRHOME installed, type: setenv PEL_DIAG 1

 EXIT CODE
  Before launch, %s returns the listed wrapper status codes.
   • For direct background launches, status 0 does not confirm that Emacs
     started successfully. %s does not return Emacs's eventual exit status.
   • For macOS application launches through open, the caller receives open's
     exit status. That status is not Emacs's eventual exit status.
  The exit codes are:
    • 0 : %s processing success.
    • 1 : selected executable or application is missing, or OS is not supported,
    • 2 : fail to identify emacs users' directory for session load operation,
    • 3 : failed session conditions check; print more info with PEL_DIAG=1,
    • 6 : internal logic error that should never happen; please report.

 SEE ALSO
  • e  : to start a terminal-based Emacs process.
  • ec : to start an Emacs daemon server or client.
  • USRHOME : shell environment control with several commands.
              At https://github.com/pierre-rouleau/usrhome
  • For the concept of session auto-loading, see:
    • PEL session PDF : describes how PEL uses easysession.el
    • easysession.el Emacs package documentation.

" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" \
  "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" \
  "$pgm_name" "$pgm_name"

    if [ "$(uname)" = "Darwin" ]; then
        printf -- "\
OS NOTES
    • On macOS the graphics version of Emacs is taken from a location
      identified by the following logic:
      • If PEL_GE_DIR is nonempty and \$PEL_GE_DIR/emacs is executable, use
        that executable. PEL_GE_DIR identifies its containing directory.
        Otherwise, use the executable inside /Applications/Emacs.app
        appropriate for the CPU architecture.
"
    fi
}

# --
# Handle help request

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    exit 0
fi

# ----------------------------------------------------------------------------
# any_error=no
error_printf() {
    # any_error=yes
    # Forward the format string and all arguments safely
    # Note: use %b in format string instead of %s if the
    #       arguments use backslash escapes.
    format_str="$1"
    shift
    printf -- "ERROR: "            >&2
    # shellcheck disable=SC2059 # The format string *is* the first argument.
    printf -- "$format_str" "$@"   >&2
}


# ----------------------------------------------------------------------------
# Identify and check Emacs process availability.
# Exit with 1 if no appropriate Emacs process is available.

ge_process=
case $(uname) in
    Darwin)
        if [ -n "$PEL_GE_DIR" ] && [ -x "$PEL_GE_DIR/emacs" ]; then
            ge_process="PEL_GE_DIR/emacs"
        elif [ -d /Applications/Emacs.app/Contents ]; then
            case "$(arch)" in
                arm64)
                    if [ -x /Applications/Emacs.app/Contents/MacOS/Emacs-arm64-11 ]; then
                        ge_process="/Applications/Emacs.app/Contents/MacOS/Emacs-arm64-11"
                    elif [ -x /Applications/Emacs.app/Contents/MacOS/Emacs ]; then
                        ge_process="/Applications/Emacs.app/Contents/MacOS/Emacs"
                    fi
                    ;;
                *)
                    # Use the general dispatcher for all others
                    # It will check what version of macOS and use the appropriate one.
                    if [ -x /Applications/Emacs.app/Contents/MacOS/Emacs ]; then
                        ge_process="/Applications/Emacs.app/Contents/MacOS/Emacs"
                    fi
                    ;;
            esac
        else
            error_printf "The required /Applications/Emacs.app is missing.
        Please install Emacs from https://emacsformacosx.com/\n"
            exit 1
        fi
        ;;

    Linux)
        # On some Linux distros, emacs-lucid is the X-Windows capable
        # GUI version of Emacs. If available use it.
        #   At this point I don't see a reason to provide an overriding
        #   mechanism using an environment variable.
        #   If someone sees one please let me know.
        if command -v emacs-lucid > /dev/null ; then
            ge_process="emacs-lucid"
        elif command -v emacs > /dev/null ; then
            ge_process="emacs"
        fi
        ;;

    *)
        error_printf "Sorry, the %s Operating System is not supported yet.
        Please create a bug report in the PEL project to request support for it.\n" "$(uname)"
        exit 1
        ;;
esac

if [ -z "$ge_process" ]; then
    printf -- "ERROR: no appropriate Emacs executable found!\n" >&2
    exit 1
fi

# ----------------------------------------------------------------------------
# Diagnostic printf
# -----------------

any_diag=no
diag_printf() {
    any_diag=yes
    case "$PEL_DIAG" in
        1)
            # Forward the format string and all arguments safely
            # Note: use %b in format string instead of %s if the
            #       arguments use backslash escapes.
            format_str="$1"
            shift
            # shellcheck disable=SC2059 # The format string *is* the first argument.
            printf "$format_str" "$@"
            ;;
    esac
}

# ----------------------------------------------------------------------------
# Detect if an auto EasySession launch is requested
# -------------------------------------------------

# Check if the -s option is present on the command line.
with_s_flag=0
session_name=

# Loop through arguments to look for -s at the very beginning.
# Extract the session name; support the following possibilities:
#  -s            -> session_name = $PEL_SESSION value, "." if unset or empty.
#  -s ABC        -> session_name = "ABC"
#  --session=ABC -> session_name = "ABC"
while [ $# -gt 0 ]; do
    case "$1" in
        -s)
            with_s_flag=1
            if [ -n "$PEL_SESSION" ]; then
                session_name="$PEL_SESSION"
            else
                session_name=.
            fi
            if [ $# -gt 1 ]; then
                # Check if the next argument starts with a hyphen
                case "$2" in
                    -*)
                        # It's another flag, so -s is alone
                        ;;
                    *)
                        # It's the value for -s
                        session_name="$2"
                        shift 1
                        ;;
                esac
            fi
            shift
            ;;

        --session=*)
            with_s_flag=1
            session_name="${1#*=}"
            shift 1
            ;;

        --)
            # Stop parsing if standard end-of-options delimiter is met
            shift
            break
            ;;
        *)
            # Stop parsing at the first argument that is not -s
            break
            ;;
    esac
done

# If diagnostics is active print info (but don't count them as errors)
if [ "$PEL_DIAG" = "1" ]; then
    printf "Using: session name: '%s'\n" "$session_name"
    printf "       other arg   : %s\n"   "$@"
fi

if [ "$with_s_flag" -eq 1 ]; then
    # User wants to auto-load an easysession session.
    # Identify location of important directory and files required for this.
    # Uses the Emacs process we would use.
    case "$ge_process" in
        PEL_GE_DIR/emacs)
            if EMACS_DIR=$("$PEL_GE_DIR/emacs" -Q --batch --eval="(princ (expand-file-name (directory-file-name user-emacs-directory)))") 2>/dev/null; then
                EASYSESSION_SESSION_DIR="$EMACS_DIR/easysession"
            else
                printf -- "ERROR: cannot identify Emacs user directory. Exiting.\n" >&2
                exit 2
            fi
            ;;

        /Applications/Emacs.app/Contents/MacOS/Emacs-arm64-11)
            if EMACS_DIR=$(/Applications/Emacs.app/Contents/MacOS/Emacs-arm64-11 -Q --batch --eval="(princ (expand-file-name (directory-file-name user-emacs-directory)))") 2>/dev/null; then
                EASYSESSION_SESSION_DIR="$EMACS_DIR/easysession"
            else
                printf -- "ERROR: cannot identify Emacs user directory. Exiting.\n" >&2
                exit 2
            fi
            ;;

        /Applications/Emacs.app/Contents/MacOS/Emacs)
            if EMACS_DIR=$(/Applications/Emacs.app/Contents/MacOS/Emacs -Q --batch --eval="(princ (expand-file-name (directory-file-name user-emacs-directory)))") 2>/dev/null; then
                EASYSESSION_SESSION_DIR="$EMACS_DIR/easysession"
            else
                printf -- "ERROR: cannot identify Emacs user directory. Exiting.\n" >&2
                exit 2
            fi
            ;;

        emacs-lucid)
            if EMACS_DIR=$(emacs-lucid -Q --batch --eval="(princ (expand-file-name (directory-file-name user-emacs-directory)))") 2>/dev/null; then
                EASYSESSION_SESSION_DIR="$EMACS_DIR/easysession"
            else
                printf -- "ERROR: cannot identify Emacs user directory. Exiting.\n" >&2
                exit 2
            fi
            ;;

        emacs)
            if EMACS_DIR=$(emacs -Q --batch --eval="(princ (expand-file-name (directory-file-name user-emacs-directory)))") 2>/dev/null; then
                EASYSESSION_SESSION_DIR="$EMACS_DIR/easysession"
            else
                printf -- "ERROR: cannot identify Emacs user directory. Exiting.\n" >&2
                exit 2
            fi
            ;;

        *)
            error_printf "Internal error in selecting Emacs program.  Please report as bug!\n"
            exit 6
            ;;
    esac

    # Restoring session requires the EasySession directory. Check its presence.
    if [ -d "$EASYSESSION_SESSION_DIR" ]; then
        # The directory exists.
        # If the requested session is "." then the PEL easysession catalog
        # file should also exist.
        # If a named session is requested check that it exists.
        if [ "$session_name" = "." ]; then
            # The session name will be extracted from the PEL easysession
            # catalog file; identify its path name.
            if [ -n "$PEL_SESSION_CATALOG" ]; then
                EASYSESSION_SESSION_CATALOG="$EMACS_DIR/$PEL_SESSION_CATALOG"
            else
                # Use the default
                EASYSESSION_SESSION_CATALOG="$EMACS_DIR/pel-easysession-catalog.txt"
            fi
            # Check if the catalog file exists.  Without it PEL won't be able
            # to open the session.
            if [ -f "$EASYSESSION_SESSION_CATALOG" ]; then
                new_pel_session="$session_name"
            else
                diag_printf "No PEL session catalog file, %s, exist\n" "$EASYSESSION_SESSION_CATALOG"
            fi
        elif [ -f "$EASYSESSION_SESSION_DIR/$session_name" ]; then
            new_pel_session="$session_name"
        else
            diag_printf "No session file %s present in %s\n" "$session_name" "$EASYSESSION_SESSION_DIR"
        fi
    else
        diag_printf "EasySession directory does not exist: %s\n" "$EASYSESSION_SESSION_DIR"
    fi

    # If there were any error detected, always print error info and exit.
    if [ "$any_diag" = "yes" ]; then
        if [ "$session_name" = "." ]; then
            printf "ERROR: Can't proceed with auto loading of dir-specific session!\n" >&2
        else
            printf "ERROR: Can't proceed with auto loading of session '%s'!\n" "$session_name" >&2
        fi
        printf "       Fix the issue or use %s without the -s option.\n" "$pgm_name" >&2
        if [ -z "$PEL_DIAG" ]; then
            printf "       Set PEL_DIAG environment variable to 1 to get more information on the error.\n" >&2
        fi
        exit 3
    else
        # No error detected.
        # The session name stored in new_pel_session must be exported
        if [ -n "$new_pel_session" ]; then
            PEL_SESSION="$new_pel_session"
            export PEL_SESSION
            unset -v new_pel_session
        fi
    fi
else
    # When ge is invoked without the -s or --session option, ensure that
    # PEL_SESSION is empty to prevent Emacs from auto-loading an easysession.
    if [ -n "$PEL_SESSION" ]; then
        unset -v PEL_SESSION
    fi
fi

# ----------------------------------------------------------------------------
# Invoke the Graphical Emacs using the process appropriate to the OS
# and environment.  This can be invoked inside an existing Emacs process
# for all the graphical Emacs programs this uses.

# In all cases, pass to the selected Emacs program command line:
#   - --chdir to the current working directory so we open the same files
#     as what is specified on the command line. If we don't do that the GUI
#     based Emacs might use a different directory (most often the home directory)
#     and if you specify files that are not in that directory they
#     will not be opened, Emacs can instead open an empty buffer for a different
#     path-name.
#
# Emacs 27+ support for PEL:
#    - To allow Emacs early-init.el code to distinguish whether Emacs is
#      running in terminal mode or in graphics mode.  When running
#      early-init.el Emacs does not know and the function
#      display-graphic-p does not work at that moment.  The only way I
#      have found is to use an environment variable.  So the following
#      code sets one up: PEL_EMACS_IN_GRAPHICS
# See: https://emacs.stackexchange.com/questions/66268/how-to-set-package-user-dir-with-emacs-27-with-package-quickstart-and-distinguis
#

case "$ge_process" in
    PEL_GE_DIR/emacs)
        export PEL_EMACS_IN_GRAPHICS=1
        # Run Emacs in the background.
        # exec replaces the background subshell, not the main ge script.
        # ge does not wait for Emacs or return its eventual exit status.
        # Prevent stream outputs from leaking into the parent shell terminal.
        exec "$PEL_GE_DIR/emacs" \
             --chdir="$(pwd)" \
             --eval '(select-frame-set-input-focus (selected-frame))' \
             "$@" >/dev/null 2>&1 &
        ;;

    /Applications/Emacs.app/Contents/MacOS/Emacs-arm64-11)
        # Under macOS use the open application to launch the GUI Emacs application.
        # -n : open a new instance on each invocation
        # -a application: identify the path of the application
        # --env : allows passing environment variable definitions to the launched application
        #
        # The macOS GUI build packs multiple binaries.
        # The umbrella/dispatcher binary is:  /Applications/Emacs.app/Contents/MacOS/Emacs
        # There are other architecture specific binaries.
        # Invoke them if they can be identified.  The value of the arch variable is not set,
        # so the `arch' command must be used.
        # Running on Apple Silicon: use the arm64 specific binary if present
        #  Replace ge with open.
        #  open returns without waiting for Emacs to exit.
        #  The caller receives open's status, not Emacs's eventual exit status.
        exec open -n -a /Applications/Emacs.app/Contents/MacOS/Emacs-arm64-11 \
             --env PEL_EMACS_IN_GRAPHICS=1 \
             --args --chdir="$(pwd)" \
             --eval '(select-frame-set-input-focus (selected-frame))' \
             "$@"
        ;;

    /Applications/Emacs.app/Contents/MacOS/Emacs)
        # Use open: open returns without waiting for Emacs to exit.
        # -n : open a new instance on each invocation
        # -a application: identify the path of the application
        # The caller receives open's status, not Emacs's eventual exit status.
        #
        # Since macOS Intel platforms run older software,
        # it's likely an older macOS system where open did not have the --env
        # option, don't use it and export PEL_EMACS_IN_GRAPHICS explicitly.
        export PEL_EMACS_IN_GRAPHICS=1
        exec open -n -a /Applications/Emacs.app/Contents/MacOS/Emacs \
             --args --chdir="$(pwd)" \
             --eval '(select-frame-set-input-focus (selected-frame))' \
             "$@"
        ;;

    emacs-lucid)
        # Under Linux, invoke emacs passing the current working directory
        # setting the PEL_EMACS_IN_GRAPHICS environment variable to inform
        # PEL about the graphics mode.
        export PEL_EMACS_IN_GRAPHICS=1
        # Run Emacs in the background.
        # exec replaces the background subshell, not the main ge script.
        # ge does not wait for Emacs or return its eventual exit status.
        # Prevent stream outputs from leaking into the parent shell terminal.
        exec emacs-lucid \
             --chdir="$(pwd)" \
             --eval '(select-frame-set-input-focus (selected-frame))' \
             "$@" >/dev/null 2>&1 &
        ;;

    emacs)
        # Under Linux, invoke emacs passing the current working directory
        # setting the PEL_EMACS_IN_GRAPHICS environment variable to inform
        # PEL about the graphics mode.
        export PEL_EMACS_IN_GRAPHICS=1
        # Run Emacs in the background.
        # exec replaces the background subshell, not the main ge script.
        # ge does not wait for Emacs or return its eventual exit status.
        # Prevent stream outputs from leaking into the parent shell terminal.
        exec emacs \
             --chdir="$(pwd)" \
             --eval '(select-frame-set-input-focus (selected-frame))' \
             "$@" >/dev/null 2>&1 &
        ;;

    *)
        error_printf "Internal error in selecting Emacs program.  Please report as bug!\n"
        exit 6
        ;;
esac

# ----------------------------------------------------------------------------
