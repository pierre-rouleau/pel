#!/bin/sh
# SH FILE: e
#
# Purpose   : Start Emacs in terminal mode.  Support multiple environments
# Created   : Wednesday, May 22 2024.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-10-08 08:33:41 EDT, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
# Launch emacs inside the current terminal shell in terminal mode.
# Prompt if being launched from inside an Emacs shell/terminal buffer.
#
# Note: if you want to execute the script under sudo, you will most likely
# need to provide the exact path to the script.

# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
# - Emacs must be installed, accessible as 'emacs'.
# - That version of Emacs must support the terminal mode with the `-nw`
#   command line option.
# - Additionally, under macOS, do NOT use the cocoa/GUI built version of Emacs;
#   it will work but it takes much more time to start, probably loading GUI library
#   files not needed by the terminal mode version of Emacs.
#

# ----------------------------------------------------------------------------
# Code
# ----
#
#

pgm_name="${0##*/}"

print_usage()
{
    printf -- "
%s -- Terminal-based Emacs launcher. Uses 'emacs -nw'.

 Usage: %s -h | --help

  • Print this help information.

 Usage: %s -- --help

  • Print Emacs help information.

 Usage: %s [OPTION-or-FILENAME]...

  • Execute emacs -nw with the specified OPTION-or-FILENAME.
    This does not auto-load any session.

 Usage: %s -s [SESSION-NAME] [--] [OPTION-or-FILENAME]...
        %s --session=SESSION_NAME [OPTION-or-FILENAME]...
        PEL_SESSION=SESSION-NAME %s -s [OPTION-or-FILENAME]...

  • Execute emacs -nw, passing the OPTION-or-FILENAME
    options to Emacs but also forcing the automatic
    loading of an easysession.  The name of the session
    is either specified on the command line as SESSION-NAME
    or taken from the PEL_SESSION environment variable according
    to the following rules:
    • If -s is specified without any session name after the -s
      or with the PEL_SESSION=SESSION-NAME before the script name
      and PEL_SESSION environment variable does not already exist
      or is currently empty, then the script requires the use of the
      directory-specific session.
      • This is the session name associated with the current directory
        identified inside the PEL easysession catalog file (see FILES).
      • If you need to specify '-s' without a session name and need to pass
        other arguments to Emacs use '-s --'.
    • If '-s' is specified with no session name but the PEL_SESSION
      environment variable has a non-empty value, the session with that name
      is auto-loaded.  The, special name '.' (without quotes) identifies a
      directory-specific session name extracted from the PEL easysession
      catalog.
    • The name directly following '-s', '--session=' or the
      'PEL_SESSION=' identifies the session name and overrides the
      session name that could be identified by the current value of
      the PEL_SESSION environment variable.  This word cannot be '--'.


  The -s and --session options force the automatic loading of a session
  using the Emacs easysession logic and are active when the following
  conditions are met:
    • The PEL pel-use-easysession      user-option is turned on.
    • The PEL pel-easysession-autoload user-option is turned on.
    • The easysession.el package is installed (PEL installs it when
      Emacs starts and pel-use-easysession is on)
    • The session directory exists (see FILES).
  For unnamed, directory-specific session invoked with -s without a name,
  the following extra condition are checked:
    • The PEL easysession catalog file exists (see FILES).
    • It has a line that identifies a session for the current directory.
    • That file is present in the session directory.

 FILES
   • Emacs user directory: most often: '~/.emacs.d' but also '~/.config/emacs/'
                           on some XDG compliant systems.
   • session directory: the 'easysession' sub-directory of the Emacs user
                        directory.
   • PEL easysession catalog file:  'pel-easysession-catalog.txt' inside the
                                     Emacs user directory.

 ENVIRONMENT
    • PEL_SESSION_CATALOG : the file name of the PEL easysession catalog file.
                            No path; the file is located inside the user's
                            Emacs directory. Overrides the default shown
                            above.  Required when the user changed the default
                            value of PEL pel-easysession-catalog-filename
                            user-option in Emacs.

 NOTES
    • %s starts Emacs within the current shell; Emacs gets access to the
      complete environment of the current shell. This includes the PATH,
      LIBPATH, MANPATH, and several other useful environment variables.  This
      can be useful in many situations.  You can even launch different Emacs
      processes from different shells, each ones having different specialized
      environments, and potentially an associated session.

 LIMITATIONS
    • The -s option does not check if a session for the current working
      directory exists in the PEL easysession catalog file.  That is done
      by Emacs pel-session.el logic.  No harm is done: Emacs won't auto-load
      a session.  Use it as a reminder to save the session with a name
      associated with the current working directory.
    • When auto-loading a session with easysession, %s assumes that the
      session information was stored inside files located inside the same
      Emacs user directory Emacs will use now.  It does not support
      restoration of sessions created by invoking Emacs with its
      --init-directory option.

 DIAGNOSTICS
  %s print error information on failures. It prints extra details when the
  PEL_DIAG environment variable is set to 1.  Specifically it displays more
  information when conditions are not met for the loading of a session.
  Use that to troubleshoot environment problems.
  • With USRHOME installed, type: setenv PEL_DIAG 1

 EXIT CODE
  • 0 : success,
  • 1 : command line error,
  • 2 : emacs not found in PATH,
  • 3 : emacs invoked inside emacs, prompt read failed,
  • 4 : fail to identify emacs users' directory for session load operation.

 SEE ALSO
  • ge : to start a Graphics-based Emacs process.
  • ec : to start a Emacs daemon server or client.
  • USRHOME : shell environment control with several commands.
              At https://github.com/pierre-rouleau/usrhome
  • For the concept of session auto-loading, see:
    • PEL session PDF : describes how PEL uses easysession.el
    • easysession.el Emacs package documentation.

" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name" \
  "$pgm_name" "$pgm_name" "$pgm_name" "$pgm_name"
}

# --
# Handle help request

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    # help requested explicitly: no error.
    exit 0
fi

# --
# Check if Emacs is present: only look for 'emacs'; nothing else is used here.

if ! command -v emacs > /dev/null 2>&1; then
    printf -- "ERROR: emacs is not found in PATH!\n" >&2
    exit 2
fi

# ----------------------------------------------------------------------------
# Diagnostic printf
# -----------------

any_diag=no
diag_printf() {
    any_diag=yes
    case "$PEL_DIAG" in
        1)
            # Forward the format string and all arguments safely
            # Note: use %b in format string instead of %s if the
            #       arguments use backslash escapes.
            format_str="$1"
            shift
            # shellcheck disable=SC2059 # The format string *is* the first argument.
            printf "$format_str" "$@"
            ;;
    esac
}

# ----------------------------------------------------------------------------
# Detect if an auto EasySession launch is requested
# -------------------------------------------------

# Check if the -s option is present on the command line.
with_s_flag=0
session_name=

# Loop through arguments to look for -s at the very beginning.
# Extract the session name; support the following possibilities:
#  -s            -> session_name = $PEL_SESSION value, "." if it does not exist
#  -s ABC        -> session_name = "ABC"
#  --session=ABC -> session_name = "ABC"
while [ $# -gt 0 ]; do
    case "$1" in
        -s)
            with_s_flag=1
            if [ -n "$PEL_SESSION" ]; then
                session_name="$PEL_SESSION"
            else
                session_name=.
            fi
            if [ $# -gt 1 ]; then
                # Check if the next argument starts with a hyphen
                case "$2" in
                    -*)
                        # It's another flag, so -s is alone
                        ;;
                    *)
                        # It's the value for -s
                        session_name="$2"
                        shift 1
                        ;;
                esac
            fi
            shift
            ;;

        --session=*)
            with_s_flag=1
            session_name="${1#*=}"
            shift 1
            ;;

        --)
            # Stop parsing if standard end-of-options delimiter is met
            shift
            break
            ;;
        *)
            # Stop parsing at the first argument that is not -s
            break
            ;;
    esac
done

# If diagnostics is active print info (but don't count them as errors)
if [ "$PEL_DIAG" = "1" ]; then
    printf "Using: session name: '%s'\n" "$session_name"
    printf "       other arg   : %s\n"   "$@"
fi

# Then check if the EasySession directory used to store the session files
# exists in the Emacs directory and contains at least one file to activate
# the option.
#

dir_has_file=0

if [ "$with_s_flag" -eq 1 ]; then
    # User wants to auto-load an easysession session.
    # Identify location of important directory and files required for this.
    # Uses emacs (we know that it is accessible).
    if EMACS_DIR=$(emacs -Q --batch --eval="(princ (expand-file-name (directory-file-name user-emacs-directory)))") 2>/dev/null; then
        EASYSESSION_SESSION_DIR="$EMACS_DIR/easysession"
        if [ -n "$PEL_SESSION_CATALOG" ]; then
            EASYSESSION_SESSION_CATALOG="$EMACS_DIR/$PEL_SESSION_CATALOG"
        else
            # Use the default
            EASYSESSION_SESSION_CATALOG="$EMACS_DIR/pel-easysession-catalog.txt"
        fi
    else
        printf -- "ERROR: cannot identify Emacs user directory. Exiting.\n"
        exit 4
    fi

    if [ -d "$EASYSESSION_SESSION_DIR" ]; then
        # The directory exists.  Check if it holds any file.
        # The pattern inside quotes ensures we check the literal folder,
        # but the trailing /* must be unquoted for globbing to work.
        for item in "$EASYSESSION_SESSION_DIR"/*; do
            # Check if the glob actually expanded to a real file/folder
            if [ -f "$item" ]; then
                dir_has_file=1
                break
            fi
        done
        if [ "$dir_has_file" -eq 1 ]; then
            # The easysession directory exists and holds at least one file.
            # If the requested session is "." then the PEL easysession catalog
            # file should also exist.
            # If a named session is requested check that it exists.
            if [ "$session_name" = "." ]; then
                # Check if the catalog file exists.  Without it PEL won't be able
                # to open the session.
                if [ -f "$EASYSESSION_SESSION_CATALOG" ]; then
                    new_pel_session="$session_name"
                else
                    diag_printf "No PEL session catalog file, %s, exist\n" "$EASYSESSION_SESSION_CATALOG"
                fi
            elif [ -f "$EASYSESSION_SESSION_DIR/$session_name" ]; then
                    new_pel_session="$session_name"
            else
                diag_printf "No session file %s present in %s\n" "$session_name" "$EASYSESSION_SESSION_DIR"
            fi
        else
            diag_printf "No session file present in %s\n" "$EASYSESSION_SESSION_DIR"
        fi
    else
        diag_printf "EasySession directory does not exist: %s\n" "$EASYSESSION_SESSION_DIR"
    fi

    # If there were any error detected, always print error info and exit.
    if [ "$any_diag" = "yes" ]; then
        if [ "$session_name" = "." ]; then
            printf "ERROR: Can't proceed with auto loading of dir-specific session!\n"
        else
            printf "ERROR: Can't proceed with auto loading of session '%s'!\n" "$session_name"
        fi
        printf "       Fix the issue or use %s without the -s option.\n" "$pgm_name"
        if [ -z "$PEL_DIAG" ]; then
            printf "       Set PEL_DIAG environment variable to 1 to get more information on the error.\n"
        fi
        exit 1
    else
        # No error detected.
        # The session name stored in new_pel_session must be exported
        if [ -n "$new_pel_session" ]; then
            PEL_SESSION="$new_pel_session"
            export PEL_SESSION
            unset -v new_pel_session
        fi
    fi
else
    # When e is invoked without the -s or --session option, ensure that
    # PEL_SESSION is empty to prevent Emacs from auto-loading an easysession.
    if [ -n "$PEL_SESSION" ]; then
        unset -v PEL_SESSION
    fi
fi

# ----------------------------------------------------------------------------
# Check if already inside Emacs and prompt whether to continue
# ------------------------------------------------------------
#
# Verify if e is invoked inside an Emacs shell and if so prompt.
# Only allow launching Emacs if the user requires it, essentially
# allowing Emacs to run inside an Emacs shell.

prompt_yn_return=
prompt_yn()
{
    # Arg 1: string prompt
    while true; do
        printf "%s [yn]? " "$1"
        if ! read -r yn; then
            prompt_yn_return=n
            printf '\nCannot read a valid response; cancelling Emacs launch.\n' >&2
            return 1
        fi
        case $yn in
            [Yy]* )
                prompt_yn_return=y
                break
                ;;
            [Nn]* )
                prompt_yn_return=n
                break
                ;;
            * ) echo "Please answer yes or no.";;
        esac
    done
}

# Use exec to launch Emacs to have emacs replace the shell running process.
# That eliminates one process in the process tree, uses less RAM, and allows
# signals (like SIGHUP or SIGTERM) are sent to the Emacs running process.
# Note that exec replaces the running script, so we can't check emacs exit
# code.
#
if [ -z "$INSIDE_EMACS" ]; then
    exec emacs -nw "$@"
else
    printf -- "ALREADY inside Emacs!\n"
    prompt_yn "Invoke another terminal-based Emacs inside this Emacs shell anyway" || exit 3
    if [ "$prompt_yn_return" = "y" ]; then
        exec emacs -nw "$@"
    else
        exit 1
    fi
fi

# ----------------------------------------------------------------------------
