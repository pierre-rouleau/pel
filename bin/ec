#!/bin/sh
# SH FILE: ec
#
# Purpose   : Launch an Emacs client to an Emacs Daemon - start the daemon if necessary.
# Created   : Wednesday, May 22 2024.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-10-19 13:44:17 EDT, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Description
# -----------
#
# Launch an Emacs client, text by default, graphical if the --gui or -g
# option is specified. Probe the requested server and start a daemon if the
# probe fails. Can also start a daemon or check a server without a client.

# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
# On macOS: install /Applications/Emacs.app from https://emacsformacosx.com/
# or set PEL_GE_DIR to the directory containing the locally installed,
# GUI-capable emacs executable and its matching emacsclient executable.
#
# On Linux: emacs and emacsclient must be available on PATH.
# With --gui, use emacs-lucid instead of emacs when it is available.

# ----------------------------------------------------------------------------
# Code
# ----
#
pgm_name="$(basename "$0")"
os_name="$(uname)"
print_usage()
{
    printf -- "\
%s : Open specified files in emacsclient. Start Emacs daemon if necessary.

 USAGES:
  ➨ %s [-h|--help]

        -h, --help: print this help.

  ➨ %s [-g|--gui] [--name=DAEMON-NAME] [FILE... | -- CLIENT-ARG...]

        Probe the requested server. If the probe fails, attempt to start
        the daemon. Then open a client connected to the requested socket
        identified by DAEMON-NAME which defaults to 'server'.

        -g, --gui:  start a graphical emacsclient, otherwise
                    start a terminal-based emacsclient (the default).

        Options before the first -- separator belong to %s.
        %s consumes that separator and passes the remaining CLIENT-ARG
        arguments to emacsclient.
        Use the separator for all native client options.
        Plain filenames can be specified before or without the separator.

  ➨ %s [-d|--start-daemon] [--name=DAEMON-NAME]

        Use --start-daemon to only start the daemon without starting
        any client.
        If the requested server responds, print a message and exit 1.
        Otherwise attempt to start the daemon.
        Client options and filenames are not accepted in this mode.

  ➨ %s [-t|--check-daemon] [--name=DAEMON-NAME]

        Check whether the requested server responds.
        Use socket server when no name is specified.
        Print the probe result on stdout. The exit code is:
        - 0 if the probe succeeds,
        - 1 for command-line, dependency, or setup errors,
        - 2 if the probe fails.
        Errors are printed on stderr.
        Client options and filenames are not accepted in this mode.

  A responding server can belong to a daemon or an ordinary Emacs
  session that enabled server-start.
  A failed probe does not prove that no daemon process exists.
  The probe can wait if Emacs is unresponsive.

  The DAEMON-NAME identifies the socket name the Emacs daemon and the
  client must use.  It's possible to create several daemons and client(s)
  attaching to that daemon by using that option.

 EXAMPLES:
     %s -d                         # ec daemon-start mode
     %s -- -d :0 file.txt          # Native client display option
     %s -t                         # ec check mode
     %s -- -t file.txt             # Native client terminal option
     %s --name=work -- --no-wait -d :0 file.txt
     %s --name=work -- --eval '(emacs-version)'
     %s -- -- --help

    The last example opens a file named --help. The second separator
    belongs to emacsclient and ends its option parsing.

    Use --name=NAME before the separator to select the socket.
    Native socket-name, server-file, and alternate-editor options are
    not accepted. Environment variables cannot override that selection.

 SUPPORTED NATIVE CLIENT OPTIONS:
    -n, --no-wait; -q, --quiet; -u, --suppress-output;
    -e, --eval; -H, --help; -V, --version;
    -t, -nw, --tty, --nw; -c, --create-frame;
    -F, --frame-parameters; -d, --display;
    -p, --parent-id; -T, --tramp.

    The last four options require a value.
    Short options take a separate value. Long options also accept =VALUE.
    Short-option bundles and abbreviated long options are not accepted.
    See the emacsclient manual for option meanings.
    Native help and version requests still perform normal client-mode
    setup, including daemon startup when the probe fails.

 NOTE: Daemon names accepted by this script must not start with a dash
       character.

" "${pgm_name}" "${pgm_name}" "${pgm_name}" "${pgm_name}" "${pgm_name}" \
  "${pgm_name}" "${pgm_name}" "${pgm_name}" "${pgm_name}" "${pgm_name}" \
  "${pgm_name}" "${pgm_name}" "${pgm_name}" "${pgm_name}"

    case "${os_name}" in
        Darwin)
        printf -- "\
 OS NOTE: Under macOS, install /Applications/Emacs.app from
          https://emacsformacosx.com/ or select a local GUI-capable build.

          You can also use a locally built Emacs, built with GUI support,
          as described in the document How to build Emacs from source in
          the PEL website on Github, at:
          https://github.com/pierre-rouleau/pel/blob/master/doc/build-emacs-from-source.rst.txt

 ENVIRONMENT:
    You can use the PEL_GE_DIR to identify the directory containing
    specific emacs and emacsclient programs you want to use here.
    The directory must hold the 2 executable programs (or links to them),
    otherwise the default is used.  The default is the macOS Emacs
    application /Applications/Emacs.app.

"
        ;;
    Linux)
        printf -- "\

    Under Linux, emacs-lucid is used to start the daemon if the --gui
    option is specified and the emacs-lucid executable file is found
    on the current PATH.  Otherwise, %s defaults to emacs.

" "${pgm_name}"
        ;;
    esac
}

# ----------------------------------------------------------------------------
# Error printf
# ------------

error_printf() {
    # Forward the format string and all arguments safely
    # Note: use %b in format string instead of %s if the
    #       arguments use backslash escapes.
    format_str="$1"
    shift
    printf -- "*** %s: ERROR ***\n" "${pgm_name}" >&2
    # shellcheck disable=SC2059 # The format string *is* the first argument.
    printf -- "$format_str" "$@"                >&2
    printf -- "*******************\n"           >&2
}

# ----------------------------------------------------------------------------
# Parse command line options
# --------------------------
# Parse ec options. Consume the first -- separator.
# Native client options require that separator; plain filenames do not.

op=''
daemon_name=''
daemon_opt="--daemon"
client_options=false
#socket_opt=''

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            print_usage
            exit 0
            ;;

        --name=*)
            if [ -n "${daemon_name}" ]; then
                error_printf "Multiple daemon names specified.\n"
                exit 1
            fi
            daemon_name="${1#*=}"
            if [ -z "${daemon_name}" ]; then
                error_printf "Empty daemon name in --name option.\n"
                exit 1
            fi
            case "${daemon_name}" in
                -*)
                    error_printf "Daemon names must not start with '-': %s\n" "${daemon_name}"
                    exit 1
                    ;;
            esac
            daemon_opt="--daemon=${daemon_name}"
            #socket_opt="--socket-name=${daemon_name}"
            shift
            ;;

        -g|--gui|-d|--start-daemon|-t|--check-daemon)
            # 1. First, check if a op was already set in a previous loop iteration
            if [ -n "$op" ]; then
                error_printf "Multiple modes specified.\n"
                exit 1
            fi

            # 2. Record the op
            case "$1" in
                -g|--gui)          op="gui" ;;
                -d|--start-daemon) op="start-daemon" ;;
                -t|--check-daemon) op="check-daemon" ;;
            esac
            shift
            ;;

        --)
            # Consume ec's separator, not emacsclient's separator.
            client_options=true
            shift
            break
            ;;

        -*)
            error_printf "Unknown %s option: %s. Put native client options after --.\n"  "${pgm_name}" "$1"
            exit 1
            ;;


        *)
            # Plain filenames do not require the separator.
            # Pass them to emacsclient program.
            break
            ;;
    esac
done

# Validate before daemon startup.
# The explicit list rejects target overrides, bundles, and abbreviations.
validate_client_arguments()
{
    while [ "$#" -gt 0 ]; do
        # Without ec's separator, accept filenames but not native options.
        if [ "$client_options" = "false" ]; then
            case "$1" in
                -*)
                    error_printf "Put native client options after %s's -- separator.\n" "${pgm_name}"
                    return 1
                    ;;
                *)
                    shift
                    continue
                    ;;
            esac
        fi

        case "$1" in
            --)
                # emacsclient owns this second separator.
                return 0
                ;;
            -n|-q|-u|-e|-H|-V|-t|-nw|-c|\
            --no-wait|--quiet|--suppress-output|--eval|--help|--version|\
            --tty|--nw|--create-frame)
                shift
                ;;
            -F|-d|-p|-T|\
            --frame-parameters|--display|--parent-id|--tramp)
                if [ "$#" -lt 2 ]; then
                    error_printf "Missing value for emacsclient option: %s\n" "$1"
                    return 1
                fi
                shift 2
                ;;
            --frame-parameters=*|--display=*|--parent-id=*|--tramp=*)
                shift
                ;;
            -*)
                error_printf "\
Unsupported or conflicting emacsclient option: %s
Use ec's --name=NAME to select the socket.
Use exact supported options, without short-option bundles.
Use a second -- before filenames that start with '-'.\n" "$1"
                return 1
                ;;
            *)
                shift
                ;;
        esac
    done
}

case "$op" in
    start-daemon|check-daemon)
        if [ "$#" -gt 0 ]; then
            error_printf "This daemon-only mode does not accept client arguments.\n"
            exit 1
        fi
        ;;
    *)
        if ! validate_client_arguments "$@"; then
            exit 1
        fi
        ;;
esac


# ----------------------------------------------------------------------------
# Identify which flavor (GUI or text) of Emacs Client to run
use_gui=false
if [ "$op" = "gui" ]; then
    use_gui=true
fi

# Identify the requested operation.  It's one of:
# - request to check the daemon
# - request to explicitly start a daemon
# - open a client and start a daemon if it is not already running.
start_daemon=false
start_client=false
check_daemon=false
if   [ "$op" = "start-daemon" ] ; then
    start_daemon=true
elif [ "$op" = "check-daemon" ] ; then
    check_daemon=true
else
    start_client=true
fi

# ----------------------------------------------------------------------------
# Select executables before probing the requested socket.

case "${os_name}" in
    Darwin)
        if [ -n "${PEL_GE_DIR:-}" ] && [ -x "$PEL_GE_DIR/emacs" ] && [ -x "$PEL_GE_DIR/emacsclient" ]; then
            macos_emacs="$PEL_GE_DIR/emacs"
            app="$PEL_GE_DIR/emacsclient"
        else
            macos_emacs=/Applications/Emacs.app/Contents/MacOS/Emacs
            # on macOS use the GUI built Emacs as client.
            case "$(arch)" in
                arm64)
                    app=/Applications/Emacs.app/Contents/MacOS/bin-arm64-11/emacsclient
                ;;

                i386)
                    case "$(sw_vers -productVersion)" in
                        10\.14\.*)
                            app=/Applications/Emacs.app/Contents/MacOS/bin-x86_64-10_14/emacsclient
                            ;;

                        10\.13\.* | 10\.12\.* | 10\.11\.* | 10\.10\.*)
                            app=/Applications/Emacs.app/Contents/MacOS/bin-x86_64-10_14/emacsclient
                            ;;

                        10\.9\.*)
                            app=/Applications/Emacs.app/Contents/MacOS/bin-x86_64-10_9/emacsclient
                            ;;

                        *)
                            app=/Applications/Emacs.app/Contents/MacOS/bin/emacsclient
                            ;;
                    esac
                    ;;
                *)
                    app=/Applications/Emacs.app/Contents/MacOS/bin/emacsclient
                    ;;
            esac
            # Fail safety: use dispatcher if the selected executable does not exist
            # in case older Emacs.app DMG is installed on the computer.
            if [ ! -x "$app" ]; then
                app=/Applications/Emacs.app/Contents/MacOS/bin/emacsclient
            fi
        fi

        if [ ! -x "$macos_emacs" ]; then
            error_printf "Cannot execute Emacs: %s\n" "$macos_emacs"
            exit 1
        fi
        if [ ! -x "$app" ]; then
            error_printf "Cannot execute emacsclient: %s\n" "$app"
            exit 1
        fi
        ;;

    Linux)
        app=emacsclient
        ;;
esac

case "${os_name}" in
    Darwin|Linux)
        if ! command -v "$app" >/dev/null 2>&1; then
            error_printf "Cannot find an executable emacsclient: %s\n" "$app"
            exit 1
        fi
        ;;
esac

# ----------------------------------------------------------------------------

# Return success only if the requested server completes an evaluation.
# A normal Emacs session with server-start also qualifies.
# Failure does not prove that no daemon process exists.
# The probe can wait if Emacs is unresponsive.
daemon_is_running()
(
    # Note:
    # ${daemon_name:-server} selects the requested name, or Emacs's standard default socket name, server.
    # Quoting preserves socket names that contain spaces.
    # --eval 't' checks whether the server responds without opening a frame.
    # --alternate-editor=false makes a failed connection return failure.
    #  Do not use --alternate-editor="" for this probe: an empty alternate editor starts a daemon.
    # The subshell limits the environment changes to the probe.

    # Ignore environment settings that could select another server
    # or start an alternate editor.
    unset EMACS_SERVER_FILE EMACS_SOCKET_NAME ALTERNATE_EDITOR

    "$app" \
        --socket-name="${daemon_name:-server}" \
        --alternate-editor=false \
        --eval 't' \
        >/dev/null 2>&1
)

# ----------------------------------------------------------------------------
# Start the daemon if necessary

case "${os_name}" in
    Darwin)
        # On macOS, check for the presence of required programs
        found_valid_pgm=0
        macos_emacs=''
        if [ -d /Applications/Emacs.app/Contents ]; then
            found_valid_pgm=1
            macos_emacs=/Applications/Emacs.app/Contents/MacOS/Emacs
        fi
        if [ -n "$PEL_GE_DIR" ] && [ -x "$PEL_GE_DIR/emacs" ]; then
            found_valid_pgm=1
            macos_emacs="$PEL_GE_DIR/emacs"
        fi
        if [ "$found_valid_pgm" = "0" ]; then
            error_printf "\
The required /Applications/Emacs.app is missing.
Please install Emacs from https://emacsformacosx.com/\n"
            exit 1
        fi

        # On macOS, start the graphics-capable Emacs daemon if it is not already running.
        if [ -z "${daemon_name}" ]; then
            if daemon_is_running; then
                if [ "${start_client}" = "false" ]; then
                    if [ "${start_daemon}" = "true" ]; then
                        printf -- "%s: an Emacs server already responds on socket server.\n" "${pgm_name}"
                      exit 1
                    elif [ "${check_daemon}" = "true" ]; then
                        printf -- "%s: the Emacs server on socket server responds.\n" "${pgm_name}"
                        exit 0
                    fi
                fi
            elif [ "${start_daemon}" = "true" ] || [ "${start_client}" = "true" ]; then
                printf -- "%s: starting the Emacs daemon for default socket name...\n" "${pgm_name}"
                if ! "$macos_emacs" "${daemon_opt}"; then
                    error_printf -- "Failed to start the Emacs daemon.\n"
                    exit 1
                fi
            elif [ "${check_daemon}" = "true" ]; then
                printf -- "%s: the Emacs server probe for socket server failed.\n" "${pgm_name}"
                printf -- "The daemon may not be started or Emacs is unresponsive.\n"
                printf -- "The lses command might provide more information.\n"
                exit 2
            fi
        else
            if daemon_is_running; then
                if [ "${start_client}" = "false" ]; then
                     if [ "${start_daemon}" = "true" ]; then
                         printf -- "%s: an Emacs server already responds on socket %s.\n" "${pgm_name}" "${daemon_name}"
                         exit 1
                     elif [ "${check_daemon}" = "true" ]; then
                         printf -- "%s: the Emacs server on socket %s responds.\n" "${pgm_name}" "${daemon_name}"
                         exit 0
                     fi

                fi
            elif [ "${start_daemon}" = "true" ] || [ "${start_client}" = "true" ]; then
                printf -- "%s : starting the Emacs daemon for socket=%s...\n" "${pgm_name}" "${daemon_name}"
                if ! "$macos_emacs" "${daemon_opt}"; then
                    error_printf "Failed to start the Emacs daemon for socket %s.\n" "${daemon_name}"
                    exit 1
                fi
            elif [ "${check_daemon}" = "true" ]; then
                printf -- "%s: the Emacs server probe for socket %s failed.\n" "${pgm_name}" "${daemon_name}"
                printf -- "The daemon may not be started or Emacs is unresponsive.\n"
                printf -- "The lses command might provide more information.\n"
                exit 2
            fi
        fi
        ;;

    Linux)
        # On Linux, use the standard Emacs program name, emacs, to start the
        # Emacs daemon.  However if emacs-lucid is present and the user
        # requested using the graphics mode then use emacs-lucid to launch the
        # Emacs daemon.
        emacs_pgm=emacs
        if [ "$use_gui" = "true" ]; then
            if command -v emacs-lucid > /dev/null ; then
                emacs_pgm=emacs-lucid
            fi
        fi
        if [ -z "${daemon_name}" ]; then
            if daemon_is_running; then
                # The requested server completed the probe.
                if [ "${start_client}" = "false" ]; then
                    if [ "${start_daemon}" = "true" ]; then
                        printf -- "%s: an Emacs server already responds on socket server.\n" "${pgm_name}"
                        exit 1
                    elif [ "${check_daemon}" = "true" ]; then
                        printf -- "%s: the Emacs server on socket server responds.\n" "${pgm_name}"
                        exit 0
                    fi
                fi
            elif [ "${start_daemon}" = "true" ] || [ "${start_client}" = "true" ]; then
                # The probe failed. Attempt to start the selected daemon.
                printf -- "%s: starting the Emacs daemon for default socket name...\n" "${pgm_name}"
                if ! "${emacs_pgm}" "${daemon_opt}"; then
                    error_printf "Failed to start the Emacs daemon.\n"
                    exit 1
                fi
            elif [ "${check_daemon}" = "true" ]; then
                printf -- "%s: the Emacs server probe for socket server failed.\n" "${pgm_name}"
                exit 2
            fi
        else
            if daemon_is_running; then
                if [ "${start_client}" = "false" ]; then
                    if [ "${start_daemon}" = "true" ]; then
                        printf -- "%s: an Emacs server already responds on socket %s.\n" "${pgm_name}" "${daemon_name}"
                        exit 1
                    elif [ "${check_daemon}" = "true" ]; then
                        printf -- "%s: the Emacs server on socket %s responds.\n" "${pgm_name}" "${daemon_name}"
                        exit 0
                    fi
                fi
            elif [ "${start_daemon}" = "true" ] || [ "${start_client}" = "true" ]; then
                printf -- "%s : starting the Emacs daemon for socket=%s...\n" "${pgm_name}" "${daemon_name}"
                if ! "${emacs_pgm}" "${daemon_opt}"; then
                    error_printf "Failed to start the Emacs daemon for socket %s.\n" "${daemon_name}"
                    exit 1
                fi
            elif [ "${check_daemon}" = "true" ]; then
                printf -- "%s: the Emacs server probe for socket %s failed.\n" "$pgm_name" "${daemon_name}"
                exit 2
            fi
        fi
        ;;
    *)
        printf -- "Sorry, the %s Operating System is not supported yet.\n" "$(uname)"
        printf -- "Please create a bug report in the PEL project to request it.\n"
        exit 1
        ;;
esac

# ----------------------------------------------------------------------------
# Start the client if requested

# emacsclient options for reference
# -a "" starts emacs daemon and reattaches
# -c creates a new frame
# -n returns control back to the terminal

if [ "${start_client}" = "true" ]; then
    # Use the same server-selection environment as the probe.
    unset EMACS_SERVER_FILE EMACS_SOCKET_NAME ALTERNATE_EDITOR

    case "${os_name}" in
        Darwin|Linux)
            # Daemon startup is handled above.
            # Do not start another editor if the connection fails.
            if [ "${use_gui}" = "true" ]; then
                "$app" -c -n \
                    --socket-name="${daemon_name:-server}" \
                    --alternate-editor=false "$@"

            else
                "$app" -nw \
                    --socket-name="${daemon_name:-server}" \
                    --alternate-editor=false "$@"
            fi
            ;;

        *)
            printf -- "Sorry, the %s Operating System is not supported yet.\n" "$(uname)"
            printf -- "Please create a bug report in the PEL project to request it.\n"
            exit 1
            ;;
    esac
fi

# ----------------------------------------------------------------------------
