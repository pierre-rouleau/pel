#!/bin/sh
# SH FILE: build-applescript
#
# Purpose   :
# Created   : Friday, October 16 2026.
# Author    : Pierre Rouleau <prouleau001@gmail.com>
# Time-stamp: <2026-10-17 11:24:41 EDT, updated by Pierre Rouleau>
# ----------------------------------------------------------------------------
# Module Description
# ------------------
#
# Build a signed macOS .app application bundle from an AppleScript file.

# ----------------------------------------------------------------------------
# Dependencies
# ------------
#
# For macOS only.

# ----------------------------------------------------------------------------
# Code
# ----
#
#

pgm_name="${0##*/}"

# --
# Identify the real user name (even if this runs in an elevated process)
# - First ask the system who logged into this terminal session
REAL_USER=$(logname 2>/dev/null)

# - Fallback method: If logname is empty (e.g. non-interactive environments)
if [ -z "$REAL_USER" ]; then
    # id -u gets the numeric ID. Under sudo, standard POSIX shells preserve the
    # login session UID or we look at the owner of the current process parent.
    # To be fully safe across environments, we can query who owns the login session.
    REAL_USER=$(id -nu "${SUDO_UID:-$(id -u)}")
fi

print_usage()
{
    printf -- "
%s -- Compile AppleScript file into a signed .app bundle file.

 Usage: %s -h | --help

  • Print this help information.

 Usage: %s SOURCE [USER-DOMAIN]

  • Compile the AppleScript SOURCE file into a .app file with the same
    base name signed with the specified USER-DOMAIN if specified or
    the real \$USER domain otherwise.

  • Examples:
    %s focus-on-ttys000
    - Compiles the focus-on-ttys000.applescript into focus-on-ttys000.app
      Signs it with the bundle ID: com.%s.focus-on-ttys000

    %s focus-on-ttys000.applescript
    - Compiles the focus-on-ttys000.applescript into focus-on-ttys000.app
      Signs it with the bundle ID: com.%s.focus-on-ttys000

    %s focus-on-ttys000 fpt22
    - Compiles the focus-on-ttys000.applescript into focus-on-ttys000.app
      Signs it with the bundle ID: com.fpt22.focus-on-ttys000

 Usage: %s SOURCE --bundle-id=BUNDLE-ID
        %s SOURCE -b BUNDLE-ID

  • Compile the AppleScript SOURCE file into a .app file with the same
    base name signed with the specified BUNDLE-ID.

  • Example:
    %s focus_on_ttys000 --bundle-id=com.hydro.focus
    - Compiles the focus_on_ttys000.applescript into focus_on_ttys000.app
      Signs it with the bundle ID: com.hydro.focus

" "$pgm_name" "$pgm_name" "$pgm_name" \
  "$pgm_name"  "$REAL_USER" \
  "$pgm_name"  "$REAL_USER" \
  "$pgm_name" \
  "$pgm_name" "$pgm_name" "$pgm_name"
}

# --
# Handle help request

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    print_usage
    # help requested explicitly: no error.
    exit 0
fi

# --
# This only runs on macOS: check it

if [ ! "$(uname)" = "Darwin" ]; then
    printf "Error: This only supports macOS.\n" >&2
    exit 1
fi

# --
# Validate arguments: at least 1 arguments must be provided
if [ "$#" -lt 1 ]; then
    printf "Invalid command: no argument provided!\n"  >&2
    printf "Use '%s -h' to print usage.\n" "$pgm_name" >&2
    exit 1
fi


# Initialize internal state variables
INPUT_PATH=""
USER_DOMAIN=""
EXPLICIT_BUNDLE_ID=""

# Argument parsing loop
while [ "$#" -gt 0 ]; do
    case "$1" in
        -b)
            if [ -z "$2" ]; then
                printf "Error: -b requires an argument.\n" >&2
                printf "Use '%s -h' to print usage.\n" "$pgm_name" >&2
                exit 1
            fi
            EXPLICIT_BUNDLE_ID="$2"
            shift 2
            ;;
        --bundle-id=*)
            # Extract everything after the '=' sign using pure POSIX text substitution
            EXPLICIT_BUNDLE_ID="${1#*=}"
            if [ -z "$EXPLICIT_BUNDLE_ID" ]; then
                printf "Error: --bundle-id= requires an argument.\n" >&2
                printf "Use '%s -h' to print usage.\n" "$pgm_name" >&2
                exit 1
            fi
            shift 1
            ;;
        -*)
            printf "Error: Unknown option '%s'\n" "$1" >&2
            printf "Use '%s -h' to print usage.\n" "$pgm_name" >&2
            exit 1
            ;;
        *)
            # Process positional arguments
            if [ -z "$INPUT_PATH" ]; then
                INPUT_PATH="$1"
            elif [ -z "$USER_DOMAIN" ]; then
                USER_DOMAIN="$1"
            else
                printf "Error: Too many positional arguments provided.\n" >&2
                printf "Use '%s -h' to print usage.\n" "$pgm_name" >&2
                exit 1
            fi
            shift 1
            ;;
    esac
done

# Ensure a SOURCE script path was actually specified
if [ -z "$INPUT_PATH" ]; then
    printf "Error: Missing required SOURCE argument.\n" >&2
    printf "Use '%s -h' to print usage.\n" "$pgm_name" >&2
    exit 1
fi

# Ensure mutual exclusivity between an explicit BUNDLE-ID and a custom USER-DOMAIN
if [ -n "$EXPLICIT_BUNDLE_ID" ] && [ -n "$USER_DOMAIN" ]; then
    printf "Error: Cannot specify both a custom USER-DOMAIN and an explicit BUNDLE-ID.\n" >&2
    printf "Use '%s -h' to print usage.\n" "$pgm_name" >&2
    exit 1
fi

# If no USER-DOMAIN argument is specified, use the real user name
if [ "$USER_DOMAIN" = "" ]; then
    USER_DOMAIN="$REAL_USER"
fi

# -- Validate first argument
# Extract just the filename to check extensions cleanly
FILE_NAME_ONLY="${INPUT_PATH##*/}"

case "$FILE_NAME_ONLY" in
    *.applescript)
        # File explicitly has the correct extension
        SOURCE_SCRIPT="$INPUT_PATH"
        ;;
    *.*)
        # File has some other extension (e.g., .txt, .scpt, .sh) -> REJECT
        printf "Error: Invalid file type. Input must have a '.applescript' extension or no extension at all.\n" >&2
        exit 1
        ;;
    *)
        # File has no extension -> Programmatically append .applescript
        SOURCE_SCRIPT="${INPUT_PATH}.applescript"
        ;;
esac

# Then check that the .applescript file exists
if [ ! -f "$SOURCE_SCRIPT" ]; then
    printf "Error: Source script file not found at '%s'\n" "$SOURCE_SCRIPT" >&2
    exit 1
fi


# --
# Prepare names

# 1. Extract the base filename without paths
FILE_NAME="${SOURCE_SCRIPT##*/}"

# 2. Safely strip the .applescript extension to get the raw name
PURE_NAME="${FILE_NAME%.applescript}"

# 3. Assemble the clean target .app package name
TARGET_APP="${PURE_NAME}.app"

# 4. Programmatically construct a perfectly structured, collision-free Bundle ID
BUNDLE_ID="com.${USER_DOMAIN}.${PURE_NAME}"
# then validate the built ID
case "$BUNDLE_ID" in
    *[!A-Za-z0-9.-]*|*..*|*.)
        printf "Error: Invalid bundle ID '%s'. Use only letters, digits, '-' and '.'.\n" "$BUNDLE_ID" >&2
        exit 1
        ;;
esac



# 5. Extract the source directory path to build the output path in the same location
case "$SOURCE_SCRIPT" in
    */*)
        APP_PATH="${SOURCE_SCRIPT%/*}/${TARGET_APP}"
        ;;
    *)
        APP_PATH="$(pwd)/${TARGET_APP}"
        ;;
esac

# macOS .app items are directories. Check if any file or folder already exists there.
if [ -e "$APP_PATH" ] || [ -h "$APP_PATH" ]; then
    printf "Error: The target bundle already exists at '%s'\n" "$APP_PATH" >&2
    printf "       Please delete or move the existing '.app' folder first before compiling.\n" >&2
    exit 1
fi

printf "
Input source:       %s
Output application: %s
Bundle ID         : %s\n\n" "${SOURCE_SCRIPT}" "${APP_PATH}" "${BUNDLE_ID}"

# --
# Build Operations
set -e

printf "1/4. Compiling '%s' into '%s'...\n" "$SOURCE_SCRIPT" "$(basename "$APP_PATH")"
osacompile -o "$APP_PATH" "$SOURCE_SCRIPT"

printf "2/4. Injecting Bundle Identifier '%s'...\n" "$BUNDLE_ID"
plutil -replace CFBundleIdentifier -string "$BUNDLE_ID" "$APP_PATH/Contents/Info.plist"

printf "3/4. Resetting Automation (TCC) system permissions...\n"
# Temporarily disable 'set -e' to catch the specific -10814 (No Application Found) error safely
set +e
TCC_OUT=$(tccutil reset AppleEvents "$BUNDLE_ID" 2>&1)
TCC_STATUS=$?
set -e
# Check if tccutil failed for reasons OTHER than a missing Launch Services entry
if [ "$TCC_STATUS" -ne 0 ]; then
    case "$TCC_OUT" in
        *-10814*)
            printf "     Note: No cached permissions found to reset (safely ignored).\n"
            ;;
        *)
            printf "Error: tccutil failed with unexpected error:\n%s\n" "$TCC_OUT" >&2
            exit "$TCC_STATUS"
            ;;
    esac
fi

printf "4/4. Generating Ad-Hoc cryptographic signature...\n"
codesign --force --deep --sign - "$APP_PATH"

printf "\nVerifying application structure and signature integrity:\n"
codesign --verify --verbose "$APP_PATH"

printf "\nBuild complete! App generated successfully at:\n%s\n" "$APP_PATH"

# ----------------------------------------------------------------------------
